{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decision-model-lab:contract:0.1",
  "title": "Internal design contracts; not a provider API schema",
  "oneOf": [{"$ref":"#/$defs/task"},{"$ref":"#/$defs/decision"},{"$ref":"#/$defs/worker_result"}],
  "$defs": {
    "id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"},
    "probability": {"type":"number","minimum":0,"maximum":1},
    "token_count": {"type":["integer","null"],"minimum":0},
    "task": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","kind","project_id","task_id","state_version","base_commit","goal","depends_on","write_paths","acceptance_ids","context_ids","risk","budget"],
      "properties": {
        "schema_version":{"const":"0.1"},"kind":{"const":"task"},
        "project_id":{"$ref":"#/$defs/id"},"task_id":{"$ref":"#/$defs/id"},
        "state_version":{"type":"integer","minimum":1},
        "base_commit":{"type":"string","pattern":"^([a-f0-9]{40}|[a-f0-9]{64})$"},
        "goal":{"type":"string","minLength":1,"maxLength":4000},
        "depends_on":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "write_paths":{"type":"array","uniqueItems":true,"maxItems":128,"items":{"type":"string","minLength":1,"maxLength":512}},
        "acceptance_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "context_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "risk":{"enum":["low","medium","high","unknown"]},
        "budget": {
          "type":"object","additionalProperties":false,
          "required":["input_token_limit","output_token_limit","max_attempts"],
          "properties": {
            "input_token_limit":{"type":"integer","minimum":0},
            "output_token_limit":{"type":"integer","minimum":0},
            "max_attempts":{"type":"integer","minimum":1}
          }
        }
      }
    },
    "decision": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","kind","task_id","state_version","model_ref","status","advice","probabilities","provider_confidence","context_id"],
      "properties": {
        "schema_version":{"const":"0.1"},"kind":{"const":"decision"},
        "task_id":{"$ref":"#/$defs/id"},"state_version":{"type":"integer","minimum":1},
        "model_ref":{"type":"string","minLength":1,"maxLength":240},
        "status":{"enum":["ok","abstain"]},
        "advice":{"enum":["cheap_worker","frontier","needs_context",null]},
        "probabilities": {
          "type":["object","null"],"additionalProperties":false,
          "required":["cheap_worker","frontier","needs_context"],
          "properties": {
            "cheap_worker":{"$ref":"#/$defs/probability"},
            "frontier":{"$ref":"#/$defs/probability"},
            "needs_context":{"$ref":"#/$defs/probability"}
          }
        },
        "provider_confidence":{"type":["number","null"],"minimum":0,"maximum":1},
        "context_id":{"$ref":"#/$defs/id"}
      },
      "allOf":[{
        "if":{"properties":{"status":{"const":"ok"}}},
        "then":{"properties":{"advice":{"type":"string"},"probabilities":{"type":"object"}}},
        "else":{"properties":{"advice":{"type":"null"},"probabilities":{"type":"null"},"provider_confidence":{"type":"null"}}}
      }]
    },
    "worker_result": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","kind","task_id","attempt_id","status","artifact_ids","summary","limitations","usage"],
      "properties": {
        "schema_version":{"const":"0.1"},"kind":{"const":"worker_result"},
        "task_id":{"$ref":"#/$defs/id"},"attempt_id":{"$ref":"#/$defs/id"},
        "status":{"enum":["candidate_ready","blocked","failed","cancelled","unknown_outcome"]},
        "artifact_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "summary":{"type":"string","maxLength":2000},
        "limitations":{"type":"array","maxItems":32,"items":{"type":"string","maxLength":1000}},
        "usage": {
          "type":"object","additionalProperties":false,
          "required":["input_tokens","cached_input_tokens","output_tokens","usd"],
          "properties": {
            "input_tokens":{"$ref":"#/$defs/token_count"},
            "cached_input_tokens":{"$ref":"#/$defs/token_count"},
            "output_tokens":{"$ref":"#/$defs/token_count"},
            "usd":{"type":["number","null"],"minimum":0}
          }
        }
      }
    }
  }
}
